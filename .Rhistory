library(stats)
portefeuilles <- read.csv("C:\\Users\\George\\Desktop\\ClassificationPortefeuilles_100.csv")
head(portefeuilles)
#aplicar escalado ##
portefeuilles = portefeuilles[, -1]
portefeuilles = scale(portefeuilles)
portefeuilles = data.frame(portefeuilles)
d <- dist(portefeuilles, method = "euclidean")
d[1:10]
fit <- hclust(d, method = "ward.D2")
plot(fit)
groups <- cutree(fit, k =4)
groups
rect.hclust(fit, k=4, border = "blue")
rect.hclust(fit, k=4, border = "yellow")
rect.hclust(fit, k=4, border = "red")
plot(portefeuilles, col = groups)
plot(groups)
res.pca <- PCA(portefeuilles, ncp = 3, graph = TRUE)
mypca = res.pca$svd$U
dpca <- dist(mypca, method = "eucladian")
fit_pca <- hclust(dpca, method = "ward.D2")
plot(fit_pca)
